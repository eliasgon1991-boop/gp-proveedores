# Copiar a .env (o configurar en Vercel → Environment Variables).
# Vacío u omitido = la app salta el backend y usa n8n → demo.
VITE_ENDPOINT_BACKEND=
# Webhook n8n de respaldo (ya tiene valor por defecto en el código; solo
# definir aquí si se quiere apuntar a otro webhook).
# VITE_ENDPOINT_DATOS=

# Cuentas + perfil en la nube (Supabase). Sin estos valores la app corre en
# modo invitado. Sacarlos de Supabase → Project Settings → API, y ejecutar
# antes supabase/esquema.sql en el SQL Editor del proyecto.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
